        "        IF f.buf_update THEN UpdateFileSize(f);",
        "{$IFDEF USE_CACHE}",
        "        { A full write cache is drained explicitly, never evicted by Put. }",
        "        IF f.buf_update AND (f.wcache<>NIL) THEN",
